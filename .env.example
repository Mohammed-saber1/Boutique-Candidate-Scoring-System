# Boutique Candidate Scoring System - Environment Variables
# Copy this file to .env and fill in values as needed.
# NEVER commit .env to version control.

# Optional: Path to trained model pipeline (defaults to app/models/model.joblib)
MODEL_PATH=

# Optional: API key for future LLM-assisted feature extraction
API_KEY=

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
